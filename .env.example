# 复制为 .env 后填写（.env 已被 git 忽略）。
DINGTALK_CLIENT_ID=
DINGTALK_CLIENT_SECRET=
DINGTALK_CORP_ID=
DINGTALK_REDIRECT_URI=http://<本机局域网IP>:5020/auth/dingtalk/callback
# 多入口时填写全部允许的回调地址（逗号分隔），并同步登记到钉钉后台。
DINGTALK_REDIRECT_URIS=
DINGTALK_AGENT_ID=
FOOT_ALLOWED_USER_IDS=
FOOT_ADMIN_USER_IDS=
FOOT_NOTIFY_USER_IDS=
FOOT_SECRET_KEY=
FOOT_PORT=5020
# 可留空自动查找本机 CLI；每个提供方的超时秒数，默认 900。
FOOT_CLAUDE_BIN=
FOOT_CODEX_BIN=
FOOT_ANALYSIS_TIMEOUT=900
# 逐场研究及最终推荐决策每个提供方的时限。
FOOT_MATCH_TIMEOUT=180
# 本次执行预算，用尽后保留检查点供续跑。
FOOT_ANALYSIS_BUDGET=1800
# 可选近期证据复用上限，0关闭；报价和最终AI决策重新获取。
FOOT_RESEARCH_REUSE_MINUTES=120
